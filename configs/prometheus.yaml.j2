global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:{{ prometheus_http_port }}"
{% if (monitoring_components_enabled | default({})).grafana | default(true) | bool %}

  - job_name: grafana
    static_configs:
      - targets:
          - "127.0.0.1:{{ grafana_http_port }}"
{% endif %}
{% if (monitoring_components_enabled | default({})).loki | default(true) | bool %}

  - job_name: loki
    static_configs:
      - targets:
          - "127.0.0.1:{{ loki_http_port }}"
{% endif %}
{% if (monitoring_components_enabled | default({})).tempo | default(true) | bool %}

  - job_name: tempo
    static_configs:
      - targets:
          - "127.0.0.1:{{ tempo_http_port }}"
{% endif %}
